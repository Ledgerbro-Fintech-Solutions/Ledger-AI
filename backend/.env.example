# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Model Selection
GROQ_MODEL_EXTRACTION=qwen/qwen3.8-27b
GROQ_MODEL_STANDARDIZATION=openai/gpt-oss-20b
GROQ_MODEL_CHAT=openai/gpt-oss-20b

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Application Config
APP_NAME="Ledger AI Unified Backend"
APP_VERSION="1.0.0"
SESSION_TIMEOUT=3600
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,tiff,bmp,webp,csv,json
MAX_FILE_SIZE=52428800
